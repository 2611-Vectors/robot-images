# Every core at its full clock from boot: a frequency ramping up and down costs Visor more frame time
# than it saves power. After Armbian's own hardware script, which sets every core's governor from
# /etc/default/cpufrequtils (ondemand) as the board starts: the two ran together, and whichever
# wrote last won.
[Unit]
Description=CPU governor: performance
DefaultDependencies=no
After=sysinit.target armbian-hardware-optimize.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for policy in /sys/devices/system/cpu/cpufreq/policy*; do echo performance > "$policy/scaling_governor"; done'

[Install]
WantedBy=multi-user.target
