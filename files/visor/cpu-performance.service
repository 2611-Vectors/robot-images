# Every core at its full clock from boot: a frequency ramping up and down costs Visor more frame time
# than it saves power.
[Unit]
Description=CPU governor: performance
DefaultDependencies=no
After=sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for policy in /sys/devices/system/cpu/cpufreq/policy*; do echo performance > "$policy/scaling_governor"; done'

[Install]
WantedBy=multi-user.target
